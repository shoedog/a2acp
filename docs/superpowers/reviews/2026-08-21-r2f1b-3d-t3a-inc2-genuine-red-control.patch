+    struct Inc2ControlProbe(std::sync::atomic::AtomicUsize);
+    impl Inc2ControlProbe {
+        fn calls(&self) -> usize { self.0.load(std::sync::atomic::Ordering::SeqCst) }
+    }
+    impl super::ExactAbsenceProbeV1 for Inc2ControlProbe {
+        fn observe_exact_absence(&self, _: &super::ExactAbsenceCandidateV1) -> Result<super::ExactAbsenceObservationV1, bridge_core::error::BridgeError> {
+            self.0.fetch_add(1, std::sync::atomic::Ordering::SeqCst);
+            Ok(super::ExactAbsenceObservationV1::BothAbsent)
+        }
+    }
+    fn inc2_control_record(root: &Path, target: &Path, state: WorktreeCustodyStateV1) -> WorktreeCustodyRecordV1 {
+        let source = root.join("source"); fs::create_dir_all(&source).unwrap();
+        assert!(std::process::Command::new("git").args(["-C", source.to_str().unwrap(), "init", "-q"]).status().unwrap().success());
+        let target = fs::canonicalize(target).unwrap();
+        let object = |path: &Path| { let directory_identity = bridge_core::fs_custody::verify_payload_directory_identity(&fs::canonicalize(path).unwrap()).unwrap(); WorktreeObjectIdentityV1 { canonical_path: directory_identity.canonical_path.clone(), directory_identity } };
+        let mut record = custody_record(&target.to_string_lossy(), WorktreeCustodyStateV1::Preserved {});
+        record.worktree = object(&target);
+        let claim = record.claim.as_mut().unwrap();
+        claim.source = object(&source); claim.root = object(root); claim.worktree = record.worktree.clone(); claim.common_dir = object(&source.join(".git"));
+        record.state = state; record
+    }
