+        });
+
+        hooks.wait_for_control_root_pin().await;
+        eprintln!(
+            "PROBE owner published before the blocking pin = {}",
+            be.preparation_guard_for_test(&session).is_some()
+        );
+        // Make the pin itself fail: the hook blocks BEFORE the open, so the open now hits ENOENT.
